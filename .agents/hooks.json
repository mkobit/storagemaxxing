{
  "project-hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bun hooks/lint-on-edit.ts",
            "type": "command"
          },
          {
            "command": "bun hooks/typecheck-on-edit.ts",
            "type": "command"
          },
          {
            "command": "bun hooks/openspec-validate-on-edit.ts",
            "type": "command"
          },
          {
            "command": "bun hooks/openspec-canonical-guard-on-edit.ts",
            "type": "command"
          }
        ],
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bun hooks/git-commit-main-guard.ts",
            "type": "command"
          },
          {
            "command": "bun hooks/bead-close-commit-guard.ts",
            "type": "command"
          }
        ],
        "matcher": "run_command"
      }
    ]
  }
}
