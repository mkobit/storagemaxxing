{
  "formula": "implementation-sync",
  "description": "Hydrate Beads from OpenSpec tasks",
  "version": 1,
  "type": "workflow",
  "vars": {
    "change_name": {
      "description": "The OpenSpec change folder name",
      "required": true
    },
    "domain": {
      "description": "Target domain label",
      "required": false
    },
    "scope": {
      "description": "Target scope label",
      "required": false
    }
  },
  "steps": [
    {
      "id": "expand-tasks",
      "title": "Expand Tasks from {{change_name}}",
      "type": "task",
      "labels": [
        "type:sync",
        "meta:openspec"
      ]
    }
  ]
}
