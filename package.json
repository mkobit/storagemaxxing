{
  "name": "storagemaxxing-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter @storagemaxxing/web build",
    "check:coverage-threshold": "bun scripts/check-coverage-threshold.ts",
    "check:ignore-parity": "bun scripts/check-gitignore-eslint-parity.ts",
    "check:sbx-env": "bun test ./scripts/check-sbx-env.test.ts ./scripts/setup-sbx-context.test.ts && bun scripts/check-sbx-env.ts",
    "dev": "bun run --filter @storagemaxxing/web dev",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "lint": "eslint . --max-warnings 0 --cache --cache-location .eslintcache --cache-strategy content && bun run format:check",
    "sbx:plan": "sbx env plan .sbx/sbxenv.yaml",
    "sbx:test:e2e": "sbx env exec .sbx/sbxenv.yaml -- bun run --filter @storagemaxxing/web test:e2e",
    "sbx:validate-kit": "sbx kit validate .sbx/kit",
    "screenshot": "bun run --filter @storagemaxxing/web screenshot",
    "test": "bun test packages ./.agents/hooks && bun run --filter @storagemaxxing/web test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "26.6.6",
    "bun-types": "1.4.4",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.5",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "jsonc-eslint-parser": "3.3.0",
    "knip": "6.43.0",
    "modern-web-guidance": "^0.0.194",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  }
}
