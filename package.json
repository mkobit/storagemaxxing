{
  "name": "storagemaxxing-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter @storagemaxxing/web build",
    "check:tasks": "bun scripts/check-tasks-consistency.ts",
    "dev": "bun run --filter @storagemaxxing/web dev",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "screenshot": "bun run --filter @storagemaxxing/web screenshot",
    "test": "bun test packages && bun run --filter @storagemaxxing/web test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.6.0",
    "@types/eslint": "9.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "26.1.0",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "bun-types": "1.3.14",
    "eslint": "10.6.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsonc": "3.2.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.4.6",
    "globals": "17.7.0",
    "jiti": "2.7.0",
    "jsonc-eslint-parser": "3.1.0",
    "modern-web-guidance": "^0.0.174",
    "prettier": "3.9.4",
    "prettier-plugin-packagejson": "3.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  }
}
