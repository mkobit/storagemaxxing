{
  "permissions": {
    "deny": ["Bash(rm -rf *)", "Bash(rm -fr *)"],
    "approve": ["TavilyWebSearchTool"]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun $CLAUDE_PROJECT_DIR/.agents/hooks/lint-on-edit.ts"
          },
          {
            "type": "command",
            "command": "bun $CLAUDE_PROJECT_DIR/.agents/hooks/typecheck-on-edit.ts"
          },
          {
            "type": "command",
            "command": "bun $CLAUDE_PROJECT_DIR/.agents/hooks/openspec-validate-on-edit.ts"
          },
          {
            "type": "command",
            "command": "bun $CLAUDE_PROJECT_DIR/.agents/hooks/openspec-canonical-guard-on-edit.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/openspec-validate.ts\"",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun $CLAUDE_PROJECT_DIR/.agents/hooks/git-commit-main-guard.ts"
          },
          {
            "type": "command",
            "command": "bun $CLAUDE_PROJECT_DIR/.agents/hooks/bead-close-commit-guard.ts"
          }
        ]
      }
    ]
  }
}
