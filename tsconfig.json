{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "paths": {
      "@storagemaxxing/assembly": ["packages/assembly/src/index.ts"],
      "@storagemaxxing/assembly/*": ["packages/assembly/src/*.ts"],
      "@storagemaxxing/catalog": ["packages/catalog/src/index.ts"],
      "@storagemaxxing/catalog/*": ["packages/catalog/src/*.ts"],
      "@storagemaxxing/geometry": ["packages/geometry/src/index.ts"],
      "@storagemaxxing/geometry/*": ["packages/geometry/src/*.ts"],
      "@storagemaxxing/packer": ["packages/packer/src/index.ts"],
      "@storagemaxxing/packer/*": ["packages/packer/src/*.ts"],
      "@storagemaxxing/store": ["packages/store/src/index.ts"],
      "@storagemaxxing/store/*": ["packages/store/src/*.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["bun-types"],
    "useDefineForClassFields": true
  },
  "exclude": ["node_modules", "**/dist"],
  "include": [
    "apps/*/src",
    "packages/*/src",
    "packages/*/test",
    "apps/*/serve.ts",
    "eslint.config.ts",
    "scripts",
    ".agents/hooks"
  ]
}
